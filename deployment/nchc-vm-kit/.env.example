# Copy this file to the path shown by ./configure-course-env.sh.
# Never commit the completed file or bake it into a VM/container image.

COMPOSE_PROJECT_NAME=nchc-cudaq-course
COURSE_IMAGE=nchc/cudaq-agentic-coding:2026-07-17
COURSE_REPO_PATH=/home/ubuntu/cudaq-agentic-coding
COURSE_SOURCE_PATH=/opt/nchc-cudaq-course/source
# Keep H200 for the NCHC classroom image. Set to an empty value only for
# workstation validation on a non-H200 GPU.
COURSE_EXPECTED_GPU_NAME=H200
JUPYTER_PORT=8888
JUPYTER_BIND_ADDRESS=0.0.0.0
# Optional IP address or DNS name shown in the clickable login URL.
# Leave blank to auto-detect the VM's primary IPv4 address.
JUPYTER_PUBLIC_HOST=
JUPYTER_TOKEN=

# Fixed NCHC classroom endpoint and model IDs; only API key values are injected.
NCHC_RAP_BASE_URL=https://portal.genai.nchc.org.tw/api/v1
RAP_NEMOTRON_3_SUPER_MODEL=NVIDIA-Nemotron-3-Super-120B-A12B
RAP_NEMOTRON_3_ULTRA_MODEL=NVIDIA-Nemotron-3-Ultra-550B-A55B
# Nemotron 3 Super and Ultra share this RAP API key.
RAP_NEMOTRON_3_ULTRA_API_KEY=
# Compatibility alias for the spelling used by some existing event exports.
RAP_NENOTRON_3_ULTRA_API_KEY=
RAP_GEMMA_26B_MODEL=gemma-4-26B-A4B-it
RAP_GEMMA_26B_API_KEY=
RAP_GEMMA_31B_MODEL=gemma-4-31B-it
RAP_GEMMA_31B_API_KEY=

# Fixed NVIDIA hosted NIM endpoint/model; leave the key blank to disable this provider.
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_API_KEY=
